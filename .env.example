# NoteBot API Keys Configuration
# Duplicate this file, rename it to '.env', and paste your actual API key(s) below.
# NoteBot will automatically auto-detect which provider you are using.

# 1. Google Gemini API Key (Recommended - 100% Free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative environment variable name for Google Gemini:
# GOOGLE_API_KEY=your_gemini_api_key_here

# 2. OpenAI API Key (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your_openai_api_key_here

# 3. Groq API Key (Free tier at https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here

# 4. OpenRouter API Key (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

